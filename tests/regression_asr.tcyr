# regression_asr.tcyr — logical vs arithmetic right shift regression
# Bug: Cyrius >> is logical (zero-fill), not arithmetic (sign-extend)
# Every negative fixed-point value was garbage without asr()
# Guardrail: ensures asr() and fixed-point math handle negatives correctly.

include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/fmt.cyr"
include "lib/io.cyr"
include "lib/assert.cyr"

include "src/fixed.cyr"
include "src/tables.cyr"

fn main() {
    alloc_init();
    tables_init();

    test_group("asr positive values");
    assert_eq(asr(256, 4), 16, "256>>4 = 16");
    assert_eq(asr(65536, 16), 1, "65536>>16 = 1");
    assert_eq(asr(0, 8), 0, "0>>8 = 0");
    assert_eq(asr(1, 0), 1, "1>>0 = 1");

    test_group("asr negative values (the critical bug)");
    # NB: these four all divide exactly, so they pass under BOTH the old
    # round-toward-zero asr and the floor asr — they do not pin the semantics.
    assert_eq(asr(0 - 100, 1), 0 - 50, "-100>>1 = -50");
    assert_eq(asr(0 - 256, 4), 0 - 16, "-256>>4 = -16");
    assert_eq(asr(0 - 65536, 16), 0 - 1, "-65536>>16 = -1");

    test_group("asr negative values FLOOR, not truncate (RC-F2 / bsp 1.2.1)");
    # The inexact cases are the ones that pin the semantics. bsp 1.2.1 (adopted
    # at doom v0.33.6) fixed `asr` to FLOOR negatives — C's signed `>>` and
    # DOOM's fixed-point math both floor — where it previously rounded toward
    # zero, which mis-wrapped flats by one texel over negative world coords.
    # doom shares bsp's `asr` engine-wide (all 95 signed-shift sites), so this
    # is the load-bearing assertion for the whole engine's negative-coord math.
    # -1000000/65536 = -15.2588… → floor -16 (round-toward-zero gave -15).
    assert_eq(asr(0 - 1000000, 16), 0 - 16, "-1000000>>16 = -16 (floor, not -15)");
    assert_eq(asr(0 - 3, 1), 0 - 2, "-3>>1 = -2 (floor; trunc gave -1)");
    assert_eq(asr(0 - 1, 1), 0 - 1, "-1>>1 = -1 (floor; trunc gave 0)");
    assert_eq(asr(0 - 7, 2), 0 - 2, "-7>>2 = -2 (floor; trunc gave -1)");

    test_group("native >>> floors negatives (v0.34.10 migration gate)");
    # v0.34.10 replaced all 96 asr() call sites in src/ with the native `>>>`
    # operator. The ENTIRE engine's negative-coordinate math now depends on `>>>`
    # emitting SAR (floor) rather than truncating toward zero — if a future
    # toolchain regressed that, flats would mis-wrap by a texel over negative
    # world coords and nothing else would fail loudly. cyrius only gained a
    # const-fold guard for `>>>` in 6.4.74 (it was unguarded from 6.4.46), which
    # is why the migration waited for the 6.4.78 pin.
    #
    # These mirror the asr() cases above EXACTLY: same inputs, same expectations.
    # asr() itself stays in lib/bsp.cyr (vendored, and bsp's own internals use
    # it), so both must agree — asserted pairwise below.
    assert_eq((0 - 1000000) >>> 16, 0 - 16, "-1000000 >>> 16 = -16 (floor)");
    assert_eq((0 - 3) >>> 1, 0 - 2, "-3 >>> 1 = -2 (floor)");
    assert_eq((0 - 1) >>> 1, 0 - 1, "-1 >>> 1 = -1 (floor)");
    assert_eq((0 - 7) >>> 2, 0 - 2, "-7 >>> 2 = -2 (floor)");
    assert_eq((0 - 100) >>> 1, 0 - 50, "-100 >>> 1 = -50");
    assert_eq((0 - 256) >>> 4, 0 - 16, "-256 >>> 4 = -16");
    assert_eq((0 - 65536) >>> 16, 0 - 1, "-65536 >>> 16 = -1");
    assert_eq(256 >>> 4, 16, "256 >>> 4 = 16 (positive unchanged)");
    assert_eq(65536 >>> 16, 1, "65536 >>> 16 = 1");
    assert_eq(0 >>> 8, 0, "0 >>> 8 = 0");
    assert_eq(1 >>> 0, 1, "1 >>> 0 = 1 (zero-bit shift)");
    # The two must remain interchangeable — the migration's core assumption.
    assert_eq((0 - 1000000) >>> 16, asr(0 - 1000000, 16), ">>> == asr (-1000000, 16)");
    assert_eq((0 - 3) >>> 1, asr(0 - 3, 1), ">>> == asr (-3, 1)");
    assert_eq((0 - 7) >>> 2, asr(0 - 7, 2), ">>> == asr (-7, 2)");
    assert_eq(12345 >>> 5, asr(12345, 5), ">>> == asr (positive)");

    test_group("fixed_to_int negative round-trip");
    var neg5 = fixed_from_int(0 - 5);
    assert_eq(fixed_to_int(neg5), 0 - 5, "to_int(from_int(-5)) = -5");
    var neg1000 = fixed_from_int(0 - 1000);
    assert_eq(fixed_to_int(neg1000), 0 - 1000, "to_int(from_int(-1000)) = -1000");
    var neg3616 = fixed_from_int(0 - 3616);
    assert_eq(fixed_to_int(neg3616), 0 - 3616, "to_int(from_int(-3616)) = -3616 (E1M1 player Y)");

    test_group("fixed_mul with negatives");
    var pos10 = fixed_from_int(10);
    var neg3 = fixed_from_int(0 - 3);
    assert_eq(fixed_to_int(fixed_mul(pos10, neg3)), 0 - 30, "10 * -3 = -30");
    assert_eq(fixed_to_int(fixed_mul(neg3, neg3)), 9, "-3 * -3 = 9");
    assert_eq(fixed_to_int(fixed_mul(neg3, pos10)), 0 - 30, "-3 * 10 = -30");

    test_group("sign_extend_16");
    # 61920 = 0xF1E0 = -3616 as signed i16
    var raw = 61920;
    var lo = raw & 0xFFFF;
    var extended = lo;
    if (lo >= 0x8000) { extended = lo - 0x10000; }
    assert_eq(extended, 0 - 3616, "sign_extend(61920) = -3616");

    return assert_summary();
}

var r = main();
syscall(60, r);
